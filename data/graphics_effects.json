  "shaders": [
    {
      "id": "fire_distortion",
      "name": "Fire Distortion",
      "category": "combat",
      "vertex_source": "attribute vec3 position; varying vec2 uv; void main() { uv = position.xy * 0.5 + 0.5; gl_Position = vec4(position, 1.0); }",
      "fragment_source": "precision mediump float; varying vec2 uv; uniform float time; uniform float intensity; void main() { float d = sin(uv.y * 10.0 + time * 5.0) * intensity * 0.02; gl_FragColor = vec4(1.0, 0.4 + d, 0.1, 0.8); }",
      "parameters": [
        {
          "name": "time",
          "type": "float",
          "default_value": 0.0,
          "description": "Elapsed time in seconds"
        },
        {
          "name": "intensity",
          "type": "float",
          "default_value": 1.0,
          "min_value": 0.0,
          "max_value": 2.0,
          "description": "Distortion strength"
        }
      ],
      "tags": ["fire", "combat", "distortion"],
      "min_quality": "medium"
    },
    {
      "id": "frost_outline",
      "name": "Frost Outline",
      "category": "combat",
      "vertex_source": "attribute vec3 position; varying vec3 world_pos; void main() { world_pos = position; gl_Position = vec4(position, 1.0); }",
      "fragment_source": "precision mediump float; varying vec3 world_pos; uniform vec3 outline_color; void main() { float d = length(world_pos.xy) - 0.48; float a = smoothstep(0.02, 0.0, d); gl_FragColor = vec4(outline_color, a * 0.8); }",
      "parameters": [
        {
          "name": "outline_color",
          "type": "vec3",
          "default_value": [0.6, 0.85, 1.0],
          "description": "Tint for frozen outline"
        }
      ],
      "tags": ["ice", "combat", "outline"],
      "min_quality": "low"
    },
    {
      "id": "hit_flash",
      "name": "Hit Flash",
      "category": "combat",
      "vertex_source": "attribute vec3 position; varying vec2 uv; void main() { uv = position.xy * 0.5 + 0.5; gl_Position = vec4(position, 1.0); }",
      "fragment_source": "precision mediump float; varying vec2 uv; uniform float flash; void main() { float v = flash * (1.0 - length(uv - 0.5) * 1.4); gl_FragColor = vec4(1.0, 1.0, 1.0, clamp(v, 0.0, 1.0)); }",
      "parameters": [
        {
          "name": "flash",
          "type": "float",
          "default_value": 1.0,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "0..1 flash intensity"
        }
      ],
      "tags": ["combat", "flash", "hit"],
      "min_quality": "low"
    },
    {
      "id": "vignette_screen",
      "name": "Vignette Screen",
      "category": "postprocess",
      "vertex_source": "attribute vec3 position; varying vec2 uv; void main() { uv = position.xy * 0.5 + 0.5; gl_Position = vec4(position, 1.0); }",
      "fragment_source": "precision mediump float; varying vec2 uv; uniform float intensity; uniform float radius; uniform vec3 color; void main() { float d = distance(uv, vec2(0.5)); float v = smoothstep(radius, radius + 0.3, d) * intensity; gl_FragColor = vec4(color, v); }",
      "parameters": [
        {
          "name": "intensity",
          "type": "float",
          "default_value": 0.3,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Edge darkening strength"
        },
        {
          "name": "radius",
          "type": "float",
          "default_value": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Inner edge of vignette"
        },
        {
          "name": "color",
          "type": "vec3",
          "default_value": [0.0, 0.0, 0.0],
          "description": "Vignette tint"
        }
      ],
      "tags": ["postprocess", "vignette"],
      "min_quality": "low"
    },
    {
      "id": "chromatic_aberration",
      "name": "Chromatic Aberration",
      "category": "postprocess",
      "vertex_source": "attribute vec3 position; varying vec2 uv; void main() { uv = position.xy * 0.5 + 0.5; gl_Position = vec4(position, 1.0); }",
      "fragment_source": "precision mediump float; varying vec2 uv; uniform float amount; uniform vec2 direction; void main() { float r = texture2D(u_texture, uv + direction * amount).r; float g = texture2D(u_texture, uv).g; float b = texture2D(u_texture, uv - direction * amount).b; gl_FragColor = vec4(r, g, b, 1.0); }",
      "parameters": [
        {
          "name": "amount",
          "type": "float",
          "default_value": 0.005,
          "min_value": 0.0,
          "max_value": 0.05,
          "description": "Separation strength"
        },
        {
          "name": "direction",
          "type": "vec2",
          "default_value": [1.0, 0.0],
          "description": "Aberration direction"
        }
      ],
      "tags": ["postprocess", "chromatic", "aberration"],
      "min_quality": "medium"
    },
    {
      "id": "pixelate",
      "name": "Pixelate",
      "category": "postprocess",
      "vertex_source": "attribute vec3 position; varying vec2 uv; void main() { uv = position.xy * 0.5 + 0.5; gl_Position = vec4(position, 1.0); }",
      "fragment_source": "precision mediump float; varying vec2 uv; uniform float pixel_size; uniform vec2 resolution; void main() { vec2 coord = floor(uv * resolution / pixel_size) * pixel_size / resolution; gl_FragColor = texture2D(u_texture, coord); }",
      "parameters": [
        {
          "name": "pixel_size",
          "type": "float",
          "default_value": 4.0,
          "min_value": 1.0,
          "max_value": 32.0,
          "description": "Pixel block size"
        },
        {
          "name": "resolution",
          "type": "vec2",
          "default_value": [800.0, 600.0],
          "description": "Screen resolution"
        }
      ],
      "tags": ["postprocess", "pixelate", "retro"],
      "min_quality": "low"
    }
  ],
